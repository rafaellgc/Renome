{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renome",
  "version": "0.12.2",
  "identifier": "io.github.rafaellgc.Renome",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Renome",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Rafael Luciano Gonçalves Correia",
    "license": "MIT",
    "shortDescription": "Batch file renamer"
  }
}
